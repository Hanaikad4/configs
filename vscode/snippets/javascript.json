	"darkmodebutton": {
		"prefix": "darkmodebutton",
		"body": [
			"const toggleTheme = () => {",
			"    const isDark = document.documentElement.classList.toggle(\"dark\")",
			"    localStorage.setItem(\"theme\", isDark ? \"dark\" : \"light\")",
			"",
			"    // Toggle between sun and moon icons visibility",
			"    const moonIcon = document.querySelector(\".moon\")",
			"    const sunIcon = document.querySelector(\".sun\")",
			"",
			"    if (moonIcon && sunIcon) {",
			"      if (isDark) {",
			"        sunIcon.style.display = \"none\"",
			"        moonIcon.style.display = \"inline\"",
			"      } else {",
			"        sunIcon.style.display = \"inline\"",
			"        moonIcon.style.display = \"none\"",
			"      }",
			"    }",
			"  }",
			"",
			"  // Check and apply stored theme",
			"  const storedTheme = localStorage.getItem(\"theme\")",
			"  if (storedTheme === \"dark\") {",
			"    document.documentElement.classList.add(\"dark\")",
			"  } else {",
			"    document.documentElement.classList.remove(\"dark\")",
			"  }",
			"",
			"  // Toggle between sun and moon icons visibility based on stored theme",
			"  const moonIcon = document.querySelector(\".moon\")",
			"  const sunIcon = document.querySelector(\".sun\")",
			"",
			"  if (moonIcon && sunIcon) {",
			"    if (storedTheme === \"dark\") {",
			"      sunIcon.style.display = \"none\"",
			"      moonIcon.style.display = \"inline\"",
			"    } else {",
			"      sunIcon.style.display = \"inline\"",
			"      moonIcon.style.display = \"none\"",
			"    }",
			"  }",
			"",
			"  document.getElementById(\"themeToggle\").addEventListener(\"click\", toggleTheme)"
		],
		"description": "description for darkmodebutton"
	}
}